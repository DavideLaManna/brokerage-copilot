# Options Trading Copilot - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Broker Configuration (choose one)
# ===========================================

# Broker to use: "alpaca" | "tradier" | "tastytrade" | "ibkr"
BROKER_PROVIDER=

# Alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Tradier
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_ID=
TRADIER_BASE_URL=https://sandbox.tradier.com

# tastytrade
TASTYTRADE_USERNAME=
TASTYTRADE_PASSWORD=
TASTYTRADE_ACCOUNT_NUMBER=

# Interactive Brokers
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ===========================================
# Database
# ===========================================
DATABASE_URL=

# ===========================================
# LLM Configuration
# ===========================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===========================================
# Application Settings
# ===========================================
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
